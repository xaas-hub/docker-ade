# Copy to .env and adjust.

# X display of the host. Must match `echo $DISPLAY`.
DISPLAY=:0

# Image to run. Override to test a locally built one, e.g. IMAGE=ade:local
#IMAGE=frugan/ade:latest

# Leave commented if the Docker daemon runs with userns-remap: the container
# stays root and is mapped to your host user. Otherwise set your own ids, or
# everything written to ./data will belong to root.
#DOCKER_USER=1000:1000

# Desktop Telematico is downloaded on first run. Override these when the
# Agenzia publishes a new version, taking both from
# https://telematici.agenziaentrate.gov.it/Main/Desktop.jsp — then
# `rm -rf data/desktop-telematico` to force a reinstall.
#DT_URL=https://swdownload1.agenziaentrate.gov.it/repos/DesktopTelematico-linux64_140.zip
#DT_SHA256=C0305F87A603E3D89780896948A5F0B87BBABBCA42306BF5FEC5904C2475595E
